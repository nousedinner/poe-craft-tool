<Window x:Class="ShiKe.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拾刻"
        Icon="pack://application:,,,/poe.ico"
        Width="720" Height="660"
        MinWidth="720" MinHeight="660"
        Background="{StaticResource WindowBackground}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 链接式按钮样式（使用说明/反馈/广告） -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- 顶部广告区（可多条，无数据时"广告位招租"占位） -->
        <Border Grid.Row="0" Margin="8,8,8,4"
                Background="{StaticResource CardBackground}"
                CornerRadius="10" BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1">
            <StackPanel x:Name="TopAdPanel" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                <Border BorderBrush="#CCC" BorderThickness="1,1,1,1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="广告位招租" Foreground="#AAA" FontSize="11"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- 主区：左侧导航 + 右侧内容 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航（项 = ITool.Name，自动来自注册表） -->
            <Border Grid.Column="0" Margin="8,4,4,4"
                    Background="{StaticResource CardBackground}"
                    CornerRadius="10" BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1">
                <ListBox x:Name="ToolList"
                         Margin="6" Background="Transparent" BorderThickness="0"
                         SelectionChanged="ToolList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="Margin" Value="2,2"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <!-- 右侧内容区（懒加载：首次选中时 CreatePage()） -->
            <Border Grid.Column="1" Margin="4,4,8,4"
                    Background="{StaticResource CardBackground}"
                    CornerRadius="10" BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1">
                <ContentPresenter x:Name="ToolContent" Margin="12"/>
            </Border>
        </Grid>

        <!-- 底部状态栏（对齐 Python：状态点/文本/说明/反馈/底部广告/使用次数） -->
        <Border Grid.Row="2" Background="#E0EAF3"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusDot" Grid.Column="0" Text="●" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="就绪" Foreground="#445566" FontSize="12"
                           VerticalAlignment="Center" Margin="6,0,12,0"/>

                <Button Grid.Column="2" Content="📖 使用说明" Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                        Click="GuideButton_Click"/>
                <TextBlock Grid.Column="3" Text="|" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center" Margin="4,0"/>
                <Button Grid.Column="4" Content="📩 反馈" Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                        Click="FeedbackButton_Click"/>

                <TextBlock Grid.Column="6" Text="已使用 0 次" x:Name="UseCountLabel"
                           Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="8,0" Visibility="Collapsed"/>

                <!-- 底部广告位（取第一条 bottom 广告，无数据时"广告位招租"） -->
                <Button Grid.Column="7" x:Name="BottomAdButton" Content="广告位招租"
                        Style="{StaticResource LinkButton}" FontSize="10" VerticalAlignment="Center"
                        Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Window>
