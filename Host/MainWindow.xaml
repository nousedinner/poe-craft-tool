<Window x:Class="ShiKe.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拾刻"
        Width="720" Height="660"
        MinWidth="720" MinHeight="660"
        Background="{StaticResource WindowBackground}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- 主区：左侧导航 + 右侧内容 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航（项 = ITool.Name，自动来自注册表） -->
            <Border Grid.Column="0" Margin="8,8,4,8"
                    Background="{StaticResource CardBackground}"
                    CornerRadius="10" BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1">
                <ListBox x:Name="ToolList"
                         Margin="6" Background="Transparent" BorderThickness="0"
                         SelectionChanged="ToolList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="Margin" Value="2,2"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <!-- 右侧内容区（懒加载：首次选中时 CreatePage()） -->
            <Border Grid.Column="1" Margin="4,8,8,8"
                    Background="{StaticResource CardBackground}"
                    CornerRadius="10" BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1">
                <ContentPresenter x:Name="ToolContent" Margin="12"/>
            </Border>
        </Grid>

        <!-- 底部状态栏（阶段5完善：状态点/使用次数/链接/广告位） -->
        <Border Grid.Row="1" Background="#E0EAF3"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Text="状态：就绪" Margin="12,0"
                       VerticalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource TextSecondary}"/>
        </Border>
    </Grid>
</Window>
