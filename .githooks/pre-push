#!/usr/bin/env bash
set -euo pipefail

# 检查每个待推送引用的最终文件树，不修改已有 Git 历史。
checker="$(dirname "$0")/check-files"
while read -r local_ref local_oid remote_ref remote_oid; do
    # 删除引用没有文件树；历史 Python legacy 分支不套用 C# 目录规则。
    if [[ $local_oid =~ ^0+$ || ( $local_ref == refs/heads/legacy && $remote_ref == refs/heads/legacy ) ]]; then
        continue
    fi
    if ! bash "$checker" "$local_oid"; then
        printf '已阻止推送：%s → %s\n' "$local_ref" "$remote_ref" >&2
        exit 1
    fi
done
