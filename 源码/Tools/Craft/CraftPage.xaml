<UserControl x:Class="ShiKe.Tools.Craft.CraftPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:ShiKe.Themes">
    <UserControl.Resources>
        <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="Background" Value="#BFFFFFFF"/>
            <Setter Property="ContentTemplate">
                <Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/></DataTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HitButton" TargetType="RadioButton" BasedOn="{StaticResource ChoiceButtonStyle}">
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ModeButton" TargetType="RadioButton" BasedOn="{StaticResource ChoiceButtonStyle}">
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
        <Style x:Key="PoolHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ClearPoolButton" TargetType="Button" BasedOn="{StaticResource CardButton}">
            <Setter Property="Foreground" Value="{StaticResource DangerRed}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="4,8,4,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="洗词缀" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock Text="选择模式、确认坐标，再设置目标词缀" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
            </StackPanel>
            <ToggleButton x:Name="EnableToolSwitch" Grid.Column="1" Content="启用洗词缀" Style="{StaticResource ModernSwitchStyle}"
                          VerticalAlignment="Center" FontWeight="SemiBold" Checked="EnableToolSwitch_Changed" Unchecked="EnableToolSwitch_Changed"/>
        </Grid>
        <!-- 三栏同时可操作；滚动只影响各栏，不改变模式或任务执行顺序。 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="ModePanel" Grid.Column="0" Style="{StaticResource PanelStyle}"
                    Background="{StaticResource ModePanelBackground}" theme:FlowingGradient.Flow="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="01  工作模式" Style="{StaticResource SectionTitle}"/>
                        <RadioButton x:Name="Mode1Radio" GroupName="Mode" Tag="1" Checked="Mode_Checked" Style="{StaticResource ModeButton}">
                            <StackPanel><TextBlock Text="单通货" FontSize="14"/><TextBlock Text="Mode 1 · 使用选择的通货" Style="{StaticResource SecondaryText}" Margin="0,5,0,0"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="Mode2Radio" GroupName="Mode" Tag="2" Checked="Mode_Checked" Style="{StaticResource ModeButton}">
                            <StackPanel><TextBlock Text="改造＋增幅" FontSize="14"/><TextBlock Text="Mode 2 · 两种通货组合" Style="{StaticResource SecondaryText}" Margin="0,5,0,0"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="Mode3Radio" GroupName="Mode" Tag="3" Checked="Mode_Checked" Style="{StaticResource ModeButton}">
                            <StackPanel><TextBlock Text="改造＋增幅＋富豪" FontSize="14"/><TextBlock Text="Mode 3 · 魔法词缀达标后富豪" Style="{StaticResource SecondaryText}" Margin="0,5,0,0"/></StackPanel>
                        </RadioButton>
                        <StackPanel x:Name="Mode2Frame" Visibility="Collapsed" Margin="2,8,0,14">
                            <TextBlock Text="Mode 2 子模式" Style="{StaticResource PoolHeading}" Margin="0,0,0,8"/>
                            <RadioButton x:Name="Mode2AltAug" Content="改造＋增幅" GroupName="M2Sub" IsChecked="True" Checked="Mode2Option_Changed" Margin="0,0,0,8"/>
                            <RadioButton x:Name="Mode2ScourAlch" Content="重铸＋点金" GroupName="M2Sub" Checked="Mode2Option_Changed"/>
                        </StackPanel>
                        <StackPanel x:Name="Mode3Frame" Visibility="Collapsed" Margin="0,8,0,14">
                            <ToggleButton x:Name="ExaltCheck" Content="富豪后使用崇高石" Style="{StaticResource ModernSwitchStyle}"
                                          FontSize="12" Checked="ExaltCheck_Changed" Unchecked="ExaltCheck_Changed"/>
                        </StackPanel>
                        <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,10,0,0">
                            <StackPanel>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="操作延迟" Style="{StaticResource PoolHeading}"/>
                                    <TextBlock x:Name="DelayValue" Grid.Column="1" Text="33 ms" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                </Grid>
                                <Slider x:Name="DelaySlider" Minimum="10" Maximum="200" Value="33" Margin="0,12,0,10"/>
                                <TextBlock Text="通货点击后的服务器同步等待" Style="{StaticResource SecondaryText}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border x:Name="CurrencyPanel" Grid.Column="2" Style="{StaticResource PanelStyle}"
                    Background="{StaticResource CurrencyPanelBackground}" theme:FlowingGradient.Flow="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="02  通货与坐标" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="点击通货名称选择，按钮用于录制位置" Style="{StaticResource SecondaryText}" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="CurrencyGrid">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="装备坐标" Style="{StaticResource PoolHeading}" Margin="0,0,0,10"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Button x:Name="ItemCoordButton" Content="设定坐标" Style="{StaticResource CardButton}" Click="ItemCoordButton_Click" MinHeight="32"/>
                                    <Button x:Name="ItemClearButton" Grid.Column="1" Content="✕" Width="26" Padding="2" Visibility="Collapsed"
                                            Margin="4,0,0,0" Click="ItemClearButton_Click" Foreground="{StaticResource DangerRed}"/>
                                </Grid>
                                <Button x:Name="ClearAllCoordsButton" Content="清空全部坐标" Style="{StaticResource CardButton}"
                                        HorizontalAlignment="Left" Margin="0,12,0,0" Click="ClearAllCoordsButton_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border x:Name="RulesPanel" Grid.Column="4" Style="{StaticResource PanelStyle}"
                    Background="{StaticResource RulesPanelBackground}" theme:FlowingGradient.Flow="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="03  词缀规则" Style="{StaticResource SectionTitle}"/>
                        <ComboBox x:Name="PresetCombo" SelectionChanged="PresetCombo_SelectionChanged" FontSize="12" ToolTip="选择配置预设"/>
                        <WrapPanel Margin="0,8,0,12">
                            <Button x:Name="SavePresetButton" Content="保存预设" Style="{StaticResource CardButton}" Click="SavePresetButton_Click" Margin="0,0,6,0"/>
                            <Button x:Name="DeletePresetButton" Content="删除" Style="{StaticResource CardButton}" Foreground="{StaticResource DangerRed}" IsEnabled="False"
                                    Click="DeletePresetButton_Click" ToolTip="删除选中预设，当前词缀设置保留" Margin="0,0,6,0"/>
                            <Button x:Name="OpenPresetsButton" Content="打开文件夹" Style="{StaticResource CardButton}" Click="OpenPresetsButton_Click"/>
                        </WrapPanel>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="主词缀池" Style="{StaticResource PoolHeading}"/>
                            <Button x:Name="ClearPrimaryButton" Grid.Column="2" Content="清空" Style="{StaticResource ClearPoolButton}" Click="ClearPrimaryButton_Click"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4,0,4,0" ToolTip="主词缀命中数">
                            <TextBlock Text="命中" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                            <RadioButton x:Name="PrimaryHit0" Content="0" Style="{StaticResource HitButton}" Tag="0" GroupName="PrimaryHit" Checked="HitCount_Checked"/>
                            <RadioButton x:Name="PrimaryHit1" Content="1" Style="{StaticResource HitButton}" Tag="1" GroupName="PrimaryHit" Checked="HitCount_Checked"/>
                            <RadioButton x:Name="PrimaryHit2" Content="2" Style="{StaticResource HitButton}" Tag="2" GroupName="PrimaryHit" Checked="HitCount_Checked"/>
                            <RadioButton x:Name="PrimaryHit3" Content="3" Style="{StaticResource HitButton}" Tag="3" GroupName="PrimaryHit" Checked="HitCount_Checked"/>
                        </StackPanel>
                        </Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="PrimaryInput" KeyDown="AffixInput_KeyDown" Tag="primary" ToolTip="输入主词缀，回车添加" FontSize="12"/>
                            <Button Grid.Column="1" Content="添加" Style="{StaticResource CardButton}" Click="AddAffixButton_Click" Tag="primary" Margin="6,0,0,0"/>
                        </Grid>
                        <WrapPanel x:Name="PrimaryTags" Margin="0,5,0,14"/>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="次词缀池" Style="{StaticResource PoolHeading}"/>
                            <Button x:Name="ClearSecondaryButton" Grid.Column="2" Content="清空" Style="{StaticResource ClearPoolButton}" Click="ClearSecondaryButton_Click"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4,0,4,0" ToolTip="次词缀命中数">
                            <TextBlock Text="命中" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                            <RadioButton x:Name="SecondaryHit0" Content="0" Style="{StaticResource HitButton}" Tag="0" GroupName="SecondaryHit" Checked="HitCount_Checked"/>
                            <RadioButton x:Name="SecondaryHit1" Content="1" Style="{StaticResource HitButton}" Tag="1" GroupName="SecondaryHit" Checked="HitCount_Checked"/>
                            <RadioButton x:Name="SecondaryHit2" Content="2" Style="{StaticResource HitButton}" Tag="2" GroupName="SecondaryHit" Checked="HitCount_Checked"/>
                            <RadioButton x:Name="SecondaryHit3" Content="3" Style="{StaticResource HitButton}" Tag="3" GroupName="SecondaryHit" Checked="HitCount_Checked"/>
                        </StackPanel>
                        </Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="SecondaryInput" KeyDown="AffixInput_KeyDown" Tag="secondary" ToolTip="输入次词缀，回车添加" FontSize="12"/>
                            <Button Grid.Column="1" Content="添加" Style="{StaticResource CardButton}" Click="AddAffixButton_Click" Tag="secondary" Margin="6,0,0,0"/>
                        </Grid>
                        <WrapPanel x:Name="SecondaryTags" Margin="0,5,0,14"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="排除词缀" Style="{StaticResource PoolHeading}"/>
                            <Button x:Name="ClearExcludeButton" Grid.Column="1" Content="清空" Style="{StaticResource ClearPoolButton}" Click="ClearExcludeButton_Click"/>
                        </Grid>
                        <TextBlock Text="改造时跳过；终检时判定失败" Style="{StaticResource SecondaryText}" Margin="0,4,0,8"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ExcludeInput" KeyDown="AffixInput_KeyDown" Tag="exclude" ToolTip="输入排除词缀，回车添加" FontSize="12"/>
                            <Button Grid.Column="1" Content="添加" Style="{StaticResource CardButton}" Click="AddAffixButton_Click" Tag="exclude" Margin="6,0,0,0"/>
                        </Grid>
                        <WrapPanel x:Name="ExcludeTags" Margin="0,5,0,2"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <WrapPanel Grid.Row="2" Margin="4,12,4,6">
            <TextBlock x:Name="CraftHotkeyHint" Text="游戏内热键启动 / 停止" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,16,0"/>
            <TextBlock x:Name="CraftStatusText" Text="就绪" Style="{StaticResource SecondaryText}"/>
        </WrapPanel>
    </Grid>
</UserControl>
