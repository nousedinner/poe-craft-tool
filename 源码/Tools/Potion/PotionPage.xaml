<UserControl x:Class="ShiKe.Tools.Potion.PotionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:ShiKe.Themes"
             Focusable="True" FocusVisualStyle="{x:Null}"
             PreviewKeyDown="Page_PreviewKeyDown" PreviewMouseDown="Page_PreviewMouseDown"
             IsKeyboardFocusWithinChanged="Page_IsKeyboardFocusWithinChanged">
    <UserControl.Resources>
        <Style x:Key="PotionKeyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="154"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="PageHeader" Style="{StaticResource ToolPageHeader}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="一键吃药" Style="{StaticResource ToolPageTitle}"/>
            <TextBlock x:Name="HotkeyHint" Grid.Column="1" Style="{StaticResource ToolPageHint}"/>
            <ToggleButton x:Name="EnableToolSwitch" Grid.Column="2" Content="启用一键吃药"
                          Style="{StaticResource ModernSwitchStyle}" VerticalAlignment="Center" FontWeight="SemiBold"
                          Checked="EnableToolSwitch_Changed" Unchecked="EnableToolSwitch_Changed"/>
        </Grid>
        <Border x:Name="PageBody" Grid.Row="1" Style="{StaticResource PanelStyle}"
                Background="{StaticResource ModePanelBackground}" theme:FlowingGradient.Flow="True">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <Border Style="{StaticResource PanelStyle}" VerticalAlignment="Top">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="142"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>
                        <ToggleButton x:Name="Slot1Switch" Tag="0" Content="药剂槽 1" Style="{StaticResource ModernSwitchStyle}"
                                      VerticalAlignment="Center" Checked="SlotSwitch_Changed" Unchecked="SlotSwitch_Changed"/>
                        <Button x:Name="Slot1KeyButton" Grid.Column="1" Tag="0" Style="{StaticResource PotionKeyButton}" Click="CaptureKey_Click"/>
                        <ToggleButton x:Name="Slot2Switch" Grid.Row="1" Tag="1" Content="药剂槽 2" Style="{StaticResource ModernSwitchStyle}"
                                      VerticalAlignment="Center" Checked="SlotSwitch_Changed" Unchecked="SlotSwitch_Changed"/>
                        <Button x:Name="Slot2KeyButton" Grid.Row="1" Grid.Column="1" Tag="1" Style="{StaticResource PotionKeyButton}" Click="CaptureKey_Click"/>
                        <ToggleButton x:Name="Slot3Switch" Grid.Row="2" Tag="2" Content="药剂槽 3" Style="{StaticResource ModernSwitchStyle}"
                                      VerticalAlignment="Center" Checked="SlotSwitch_Changed" Unchecked="SlotSwitch_Changed"/>
                        <Button x:Name="Slot3KeyButton" Grid.Row="2" Grid.Column="1" Tag="2" Style="{StaticResource PotionKeyButton}" Click="CaptureKey_Click"/>
                        <ToggleButton x:Name="Slot4Switch" Grid.Row="3" Tag="3" Content="药剂槽 4" Style="{StaticResource ModernSwitchStyle}"
                                      VerticalAlignment="Center" Checked="SlotSwitch_Changed" Unchecked="SlotSwitch_Changed"/>
                        <Button x:Name="Slot4KeyButton" Grid.Row="3" Grid.Column="1" Tag="3" Style="{StaticResource PotionKeyButton}" Click="CaptureKey_Click"/>
                        <ToggleButton x:Name="Slot5Switch" Grid.Row="4" Tag="4" Content="药剂槽 5" Style="{StaticResource ModernSwitchStyle}"
                                      VerticalAlignment="Center" Checked="SlotSwitch_Changed" Unchecked="SlotSwitch_Changed"/>
                        <Button x:Name="Slot5KeyButton" Grid.Row="4" Grid.Column="1" Tag="4" Style="{StaticResource PotionKeyButton}" Click="CaptureKey_Click"/>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="2" Style="{StaticResource ToolPageFooter}">
            <TextBlock x:Name="CaptureHint" Visibility="Collapsed" VerticalAlignment="Center"
                       Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</UserControl>
