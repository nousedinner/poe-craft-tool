<UserControl x:Class="ShiKe.Tools.Hideout.HideoutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theme="clr-namespace:ShiKe.Themes">
    <Border Style="{StaticResource PanelStyle}" Background="{StaticResource CurrencyPanelBackground}" theme:FlowingGradient.Flow="True" MaxWidth="760" Padding="28"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
        <TextBlock Text="一键回城" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,16"/>

        <Border Background="{StaticResource CardBackground}" CornerRadius="8" Padding="16,14" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="EnableCheck"
                              Content="启用一键回城"
                              Style="{StaticResource ModernSwitchStyle}"
                              FontSize="15"
                              VerticalAlignment="Center"
                              Checked="OnToggleChanged"
                              Unchecked="OnToggleChanged"/>
                    <TextBlock x:Name="HotkeyLabel" Text="（热键）" Foreground="{StaticResource TextSecondary}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" FontSize="13" LineHeight="20">
                    <Run x:Name="InstructionHotkeyRun" Text="游戏内按热键：自动打开聊天框输入 "/>
                    <Run Text="/hideout" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}"/>
                    <Run Text=" 并发送，返回藏身处。"/>
                </TextBlock>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="12">
                    <Run Text="提示：需在游戏设置中允许聊天输入；游戏为管理员运行时拾刻请同样以管理员运行。"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="执行命令" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    <TextBox x:Name="CommandText" Width="180" Margin="10,0,0,0" Padding="5,3" MaxLength="200"
                             TextChanged="CommandText_Changed"
                             LostFocus="CommandText_Commit" KeyDown="CommandText_KeyDown"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</ScrollViewer></Border></UserControl>
