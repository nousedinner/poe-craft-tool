<UserControl x:Class="ShiKe.Tools.Hideout.HideoutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:ShiKe.Themes">
    <Grid x:Name="PageRoot">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="PageHeader" Style="{StaticResource ToolPageHeader}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="一键回城" Style="{StaticResource ToolPageTitle}"/>
            <TextBlock x:Name="HotkeyLabel" Grid.Column="1" Style="{StaticResource ToolPageHint}"/>
            <ToggleButton x:Name="EnableCheck" Grid.Column="2" Content="启用一键回城" Style="{StaticResource ModernSwitchStyle}"
                          FontWeight="SemiBold" VerticalAlignment="Center" Checked="OnToggleChanged" Unchecked="OnToggleChanged"/>
        </Grid>
        <Border x:Name="PageBody" Grid.Row="1" Style="{StaticResource PanelStyle}"
                Background="{StaticResource CurrencyPanelBackground}" theme:FlowingGradient.Flow="True">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <Border Style="{StaticResource PanelStyle}" VerticalAlignment="Top">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="回城命令" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBox x:Name="CommandText" Grid.Column="1" MaxLength="200" FontFamily="Consolas"
                                 TextChanged="CommandText_Changed" LostFocus="CommandText_Commit" KeyDown="CommandText_KeyDown"/>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="2" Style="{StaticResource ToolPageFooter}">
        </Grid>
    </Grid>
</UserControl>
