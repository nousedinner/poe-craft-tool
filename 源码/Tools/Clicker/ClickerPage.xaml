<UserControl x:Class="ShiKe.Tools.Clicker.ClickerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theme="clr-namespace:ShiKe.Themes">
<UserControl.Resources><Style x:Key="ChoiceButton" TargetType="RadioButton" BasedOn="{StaticResource ChoiceButtonStyle}"><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Padding" Value="24,10"/></Style></UserControl.Resources>

    <Border Style="{StaticResource PanelStyle}" Background="{StaticResource ModePanelBackground}" theme:FlowingGradient.Flow="True" MaxWidth="760" Padding="28"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="连点器" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            <ToggleButton x:Name="EnableToolSwitch" Grid.Column="1" Content="启用连点器"
                          Style="{StaticResource ModernSwitchStyle}"
                          Checked="EnableToolSwitch_Changed" Unchecked="EnableToolSwitch_Changed"/>
        </Grid>
        <TextBlock Text="在当前鼠标位置连续点击；离开游戏窗口后自动暂停。" FontSize="12"
                   Foreground="{StaticResource TextSecondary}" Margin="0,4,0,16"/>

        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="点击按键" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="LeftButtonRadio" Content="左键" GroupName="MouseButton"
                                 Style="{StaticResource ChoiceButton}" Checked="MouseButton_Checked"/>
                    <RadioButton x:Name="RightButtonRadio" Content="右键" GroupName="MouseButton"
                                 Style="{StaticResource ChoiceButton}" Checked="MouseButton_Checked"/>
                </StackPanel>

                <TextBlock Text="点击间隔" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,18,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Slider x:Name="IntervalSlider" Minimum="10" Maximum="200" Width="250"
                            ValueChanged="IntervalSlider_ValueChanged"
                            PreviewMouseLeftButtonUp="IntervalSlider_Commit"/>
                    <TextBlock x:Name="IntervalValue" Width="62" Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel>
                <TextBlock x:Name="HotkeyHint" Foreground="{StaticResource TextPrimary}" FontSize="12" TextWrapping="Wrap"/>
                <TextBlock Text="切换热键按一次启动、再按一次停止；按住热键松开后立即停止。"
                           Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <TextBlock x:Name="StatusDot" Text="●" Foreground="#AAAAAA" FontSize="15"
                       Margin="0,0,5,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="连点器就绪" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
            <TextBlock Text="已点击:" Foreground="{StaticResource TextSecondary}" Margin="20,0,5,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="ClickCountText" Text="0" Foreground="{StaticResource AccentBrush}"
                       FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Text="提示：使用连点器快捷键启动或停止；主屏左上角 100×200 安全区也会自动停止。"
                   Foreground="#9A7B45" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</ScrollViewer></Border></UserControl>
