<UserControl x:Class="ShiKe.Tools.Clicker.ClickerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:ShiKe.Themes">
    <UserControl.Resources>
        <Style x:Key="ChoiceButton" TargetType="RadioButton" BasedOn="{StaticResource ChoiceButtonStyle}">
            <Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Padding" Value="24,10"/>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="PageRoot">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="PageHeader" Style="{StaticResource ToolPageHeader}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="连点器" Style="{StaticResource ToolPageTitle}"/>
            <TextBlock x:Name="HotkeyHint" Grid.Column="1" Style="{StaticResource ToolPageHint}"/>
            <ToggleButton x:Name="EnableToolSwitch" Grid.Column="2" Content="启用连点器"
                          Style="{StaticResource ModernSwitchStyle}" VerticalAlignment="Center" FontWeight="SemiBold"
                          Checked="EnableToolSwitch_Changed" Unchecked="EnableToolSwitch_Changed"/>
        </Grid>
        <Border x:Name="PageBody" Grid.Row="1" Style="{StaticResource PanelStyle}"
                Background="{StaticResource ModePanelBackground}" theme:FlowingGradient.Flow="True">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Text="点击按键" Style="{StaticResource SectionTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="LeftButtonRadio" Content="左键" GroupName="MouseButton" Style="{StaticResource ChoiceButton}" Checked="MouseButton_Checked"/>
                                <RadioButton x:Name="RightButtonRadio" Content="右键" GroupName="MouseButton" Style="{StaticResource ChoiceButton}" Checked="MouseButton_Checked"/>
                            </StackPanel>
                            <TextBlock Text="点击间隔" Style="{StaticResource SectionTitle}" Margin="0,24,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Slider x:Name="IntervalSlider" Minimum="10" Maximum="200" ValueChanged="IntervalSlider_ValueChanged" PreviewMouseLeftButtonUp="IntervalSlider_Commit"/>
                                <TextBlock x:Name="IntervalValue" Grid.Column="1" Width="65" Margin="14,0,0,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="2" Style="{StaticResource ToolPageFooter}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="StatusDot" Text="●" Foreground="#AAAAAA" Margin="0,0,5,0"/>
                <TextBlock x:Name="StatusText" Text="连点器就绪" Foreground="{StaticResource TextSecondary}"/>
                <TextBlock Text="已点击" Foreground="{StaticResource TextSecondary}" Margin="20,0,5,0"/>
                <TextBlock x:Name="ClickCountText" Text="0" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
