<UserControl x:Class="ShiKe.Tools.KeyLoop.KeyLoopPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:ShiKe.Themes" PreviewKeyDown="Page_PreviewKeyDown">
    <Grid x:Name="PageRoot">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="PageHeader" Style="{StaticResource ToolPageHeader}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="按键循环" Style="{StaticResource ToolPageTitle}"/>
            <ToggleButton x:Name="EnableToolSwitch" Grid.Column="1" Content="启用按键循环" Style="{StaticResource ModernSwitchStyle}"
                          FontWeight="SemiBold" VerticalAlignment="Center" Checked="EnableToolSwitch_Changed" Unchecked="EnableToolSwitch_Changed"/>
        </Grid>
        <Border x:Name="PageBody" Grid.Row="1" Style="{StaticResource PanelStyle}"
                Background="{StaticResource RulesPanelBackground}" theme:FlowingGradient.Flow="True">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel x:Name="SlotPanel"/>
                    <Button x:Name="MoreButton" Content="▼ 加载更多 (5/10)" Height="31" Margin="0,5,0,0"
                            Background="{StaticResource CardBackground}" Click="MoreButton_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="2" Style="{StaticResource ToolPageFooter}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="StatusDot" Text="●" Foreground="#AAAAAA" Margin="0,0,5,0"/>
                <TextBlock x:Name="StatusText" Text="按键循环就绪" Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="启停" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,0,6,0"/>
                <TextBlock x:Name="HotkeyText" Foreground="{StaticResource AccentBrush}" FontSize="12"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>