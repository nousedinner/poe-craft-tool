<UserControl x:Class="ShiKe.Tools.Settings.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:ShiKe.Themes"
             Focusable="True" FocusVisualStyle="{x:Null}"
             PreviewKeyDown="Page_PreviewKeyDown" PreviewKeyUp="Page_PreviewKeyUp">
    <UserControl.Resources>
        <Style x:Key="HotkeyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="5,3"/><Setter Property="Width" Value="118"/><Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ClearHotkeyButton" TargetType="Button" BasedOn="{StaticResource HotkeyButton}">
            <Setter Property="Width" Value="46"/><Setter Property="Margin" Value="6,0,0,0"/><Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="PageRoot">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="PageHeader" Style="{StaticResource ToolPageHeader}">
            <TextBlock Text="设置" Style="{StaticResource ToolPageTitle}"/>
        </Grid>
        <Grid x:Name="PageBody" Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="HotkeyPanel" Grid.Column="0" Style="{StaticResource PanelStyle}"
                        Background="{StaticResource ModePanelBackground}" theme:FlowingGradient.Flow="True">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="热键" Style="{StaticResource SectionTitle}"/>
                            <Grid x:Name="HotkeyRows"/>
                            <Button Content="恢复默认热键" HorizontalAlignment="Left" Margin="0,16,0,0" Click="RestoreDefaultHotkeys_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <Border x:Name="GeneralSettingsPanel" Grid.Column="2" Style="{StaticResource PanelStyle}"
                        Background="{StaticResource CurrencyPanelBackground}" theme:FlowingGradient.Flow="True">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                                <TextBlock Text="游戏、声音与通知" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="目标游戏进程" Style="{StaticResource SettingLabel}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ProcessCombo" SelectionChanged="RealtimeSetting_Changed"/>
                                    <Button Grid.Column="1" Content="刷新" Width="55" Margin="7,0,0,0" Click="RefreshProcesses_Click"/>
                                </Grid>
                                <Grid Margin="0,10,0,0" Height="32">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="自动检测 PoE" Style="{StaticResource SettingLabel}"/>
                                    <ToggleButton x:Name="AutoDetectCheck" Grid.Column="1" Style="{StaticResource ModernSwitchStyle}" VerticalAlignment="Center"
                                                  Checked="RealtimeSetting_Changed" Unchecked="RealtimeSetting_Changed"/>
                                </Grid>
                        <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="声音与通知" Style="{StaticResource SectionTitle}"/>
                                <Grid Height="32">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="命中音效" Style="{StaticResource SettingLabel}"/>
                                    <ToggleButton x:Name="CraftSoundCheck" Grid.Column="1" Style="{StaticResource ModernSwitchStyle}" VerticalAlignment="Center"
                                                  Checked="RealtimeSetting_Changed" Unchecked="RealtimeSetting_Changed"/>
                                </Grid>
                                <Grid Margin="0,8,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="SoundCombo" SelectionChanged="RealtimeSetting_Changed"/>
                                    <Button Grid.Column="1" Content="试听" Width="48" Margin="7,0,0,0" Click="PreviewSound_Click"/>
                                    <Button Grid.Column="2" Content="刷新" Width="48" Margin="7,0,0,0" Click="RefreshSounds_Click"/>
                                    <Button Grid.Column="3" Content="目录" Width="48" Margin="7,0,0,0" Click="OpenSoundsFolder_Click"/>
                                </Grid>
                                <Grid Height="32">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="洗词缀弹窗" Style="{StaticResource SettingLabel}"/>
                                    <ToggleButton x:Name="CraftPopupCheck" Grid.Column="1" Style="{StaticResource ModernSwitchStyle}" VerticalAlignment="Center"
                                                  Checked="RealtimeSetting_Changed" Unchecked="RealtimeSetting_Changed"/>
                                </Grid>
                                <Grid Height="32">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="连点器弹窗" Style="{StaticResource SettingLabel}"/>
                                    <ToggleButton x:Name="ClickerNotificationCheck" Grid.Column="1" Style="{StaticResource ModernSwitchStyle}" VerticalAlignment="Center"
                                                  Checked="RealtimeSetting_Changed" Unchecked="RealtimeSetting_Changed"/>
                                </Grid>
                                <Grid Height="32">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="按键循环弹窗" Style="{StaticResource SettingLabel}"/>
                                    <ToggleButton x:Name="KeyLoopNotificationCheck" Grid.Column="1" Style="{StaticResource ModernSwitchStyle}" VerticalAlignment="Center"
                                                  Checked="RealtimeSetting_Changed" Unchecked="RealtimeSetting_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
        </Grid>
        <Grid Grid.Row="2" Style="{StaticResource ToolPageFooter}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border x:Name="ResultPanel" Visibility="Collapsed" Padding="6,2" CornerRadius="5" VerticalAlignment="Center">
                <TextBlock x:Name="ResultText" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
            </Border>
            <Button Grid.Column="1" Content="隐私与统计" Background="Transparent" BorderThickness="0" Padding="4,2" Foreground="{StaticResource TextSecondary}"
                    Click="OpenStatistics_Click" ToolTip="启动时发送固定匿名 pageview；不上传身份、设备参数、游戏数据、规则、坐标或剪贴板内容。"/>
        </Grid>
    </Grid>
</UserControl>
