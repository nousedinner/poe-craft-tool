<Window x:Class="ShiKe.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:ShiKe.Themes"
        Title="拾刻" Icon="pack://application:,,,/拾刻;component/poe.ico"
        Width="1100" Height="800" MinWidth="930" MinHeight="620"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Foreground="{StaticResource TextPrimary}" Background="{StaticResource WindowBackground}"
        theme:FlowingGradient.Speed="{Binding Value, ElementName=GradientSpeed}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="LinkText"><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/></DataTemplate>
        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="ContentTemplate" Value="{StaticResource LinkText}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>
        <!-- 工具仍由注册表生成；横向导航保留原来的选择事件和页面缓存。 -->
        <Border Grid.Row="0" Margin="16,12,16,8" Style="{StaticResource PanelStyle}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="拾刻" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>
                <ListBox x:Name="ToolList" Grid.Column="1" Background="Transparent" BorderThickness="0"
                         VerticalAlignment="Center" SelectionChanged="ToolList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Padding" Value="14,9"/>
                            <Setter Property="Margin" Value="2,0"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Surface" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource AccentSoft}"/></Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource AccentBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="流动速度" FontSize="12" VerticalAlignment="Center"/>
                    <Slider x:Name="GradientSpeed" Minimum="0" Maximum="5" Value="2" Width="80" Margin="9,0"
                            TickFrequency="1" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ToolTip="0 关闭，1～5 由慢到快"/>
                    <TextBlock Text="{Binding Value, ElementName=GradientSpeed, StringFormat={}{0:0}}" Width="16" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
        <ContentPresenter x:Name="ToolContent" Grid.Row="1" Margin="16,0,16,8"/>
        <!-- 原来的多条 top 广告统一移到内容下方；仍保留 bottom 广告及链接入口。 -->
        <Border Grid.Row="2" Margin="16,0,16,8" Style="{StaticResource PanelStyle}" Padding="12,8" MinHeight="46">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="推广" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TopAdPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="广告位招租" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </ScrollViewer>
                <Button x:Name="BottomAdButton" Grid.Column="2" Content="广告位招租" Style="{StaticResource LinkButton}" Visibility="Collapsed" MaxWidth="300" Margin="12,0,0,0"/>
            </Grid>
        </Border>
        <Border Grid.Row="3" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusDot" Text="●" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="就绪" Foreground="{StaticResource TextSecondary}" FontSize="12"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" VerticalAlignment="Center" Margin="7,0,12,0"/>
                <TextBlock x:Name="UseCountLabel" Grid.Column="2" Text="已使用 0 次" Foreground="{StaticResource AccentBrush}" FontSize="12"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,14,0" Visibility="Collapsed"/>
                <Button Grid.Column="3" Content="使用说明" Style="{StaticResource LinkButton}" Click="GuideButton_Click"/>
                <Button Grid.Column="4" Content="反馈" Style="{StaticResource LinkButton}" Click="FeedbackButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
