<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms 互操作：阶段2 托盘 NotifyIcon 用 -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ShiKe</RootNamespace>
    <AssemblyName>拾刻</AssemblyName>
    <ApplicationIcon>poe.ico</ApplicationIcon>
    <!-- 版本单一来源：续用 1.x 系列，C# 版从 v1.0.5 起（方案 §10） -->
    <Version>1.0.17</Version>
    <AssemblyTitle>拾刻</AssemblyTitle>
    <Product>拾刻</Product>
    <Description>PoE 洗词缀自动化 + 连点器 + 按键循环 + 一键回城聚合工具（C# 重构版）</Description>
  </PropertyGroup>

  <!-- WPF 项目的隐式 using 不含 System.IO / System.Net.Http（WindowsDesktop SDK 默认列表差异），显式加回 -->
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <!-- 移除 WinForms/System.Drawing 隐式 using，避免与 WPF 的 Application/Point 撞名；
         TrayService 等需要时在文件内显式 using System.Windows.Forms -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- poe.ico 嵌入程序集资源：托盘/窗口图标运行时从资源加载，发布不依赖外部文件 -->
  <ItemGroup>
    <Resource Include="poe.ico" />
  </ItemGroup>

  <!-- sounds/ 目录复制到输出目录（SoundService 从 AppContext.BaseDirectory/sounds/ 查找音效文件） -->
  <ItemGroup>
    <None Include="sounds\**" CopyToOutputDirectory="PreserveNewest" Link="sounds\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="data\presets\**" CopyToOutputDirectory="PreserveNewest" Link="data\presets\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- 内部测试是独立控制台项目，不能参与 WPF 主程序编译。 -->
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <InternalsVisibleTo Include="ShiKe.InternalTests" />
  </ItemGroup>

</Project>
