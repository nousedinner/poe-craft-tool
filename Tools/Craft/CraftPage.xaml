<UserControl x:Class="ShiKe.Tools.Craft.CraftPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:craft="clr-namespace:ShiKe.Tools.Craft">
    <UserControl.Resources>
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="#80FFFFFF"/>
            <Setter Property="BorderBrush" Value="#260050A0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#55666666"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="HitButton" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#55666666"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#80FFFFFF" BorderBrush="#260050A0" BorderThickness="1"
                                CornerRadius="4" Padding="6,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="4" MaxWidth="540">
            <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                <ToggleButton x:Name="EnableToolSwitch" Content="启用洗词缀"
                              Style="{StaticResource ModernSwitchStyle}"
                              FontSize="13" FontWeight="SemiBold"
                              Checked="EnableToolSwitch_Changed" Unchecked="EnableToolSwitch_Changed"/>
            </StackPanel>
            <!-- 模式选择 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                <RadioButton x:Name="Mode1Radio" Content="🔨 Mode 1&#x0a;单通货" GroupName="Mode"
                             Checked="Mode_Checked" Tag="1" Margin="4,0" FontSize="12" Cursor="Hand" Padding="10,6"/>
                <RadioButton x:Name="Mode2Radio" Content="⚡ Mode 2&#x0a;改造+增幅" GroupName="Mode"
                             Checked="Mode_Checked" Tag="2" Margin="4,0" FontSize="12" Cursor="Hand" Padding="10,6"/>
                <RadioButton x:Name="Mode3Radio" Content="💎 Mode 3&#x0a;改+增+富" GroupName="Mode"
                             Checked="Mode_Checked" Tag="3" Margin="4,0" FontSize="12" Cursor="Hand" Padding="10,6"/>
            </StackPanel>

            <!-- Mode 2 子模式 -->
            <StackPanel x:Name="Mode2Frame" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,6">
                <TextBlock Text="Mode 2 子模式:" Foreground="#334455" FontSize="12" VerticalAlignment="Center"/>
                <RadioButton x:Name="Mode2AltAug" Content="改造+增幅" GroupName="M2Sub" IsChecked="True"
                             Foreground="#334455" FontSize="12" Margin="8,0,0,0" Cursor="Hand"
                             Checked="Mode2Option_Changed"/>
                <RadioButton x:Name="Mode2ScourAlch" Content="重铸+点金" GroupName="M2Sub"
                             Foreground="#334455" FontSize="12" Margin="8,0,0,0" Cursor="Hand"
                             Checked="Mode2Option_Changed"/>
            </StackPanel>

            <!-- Mode 3 崇高 -->
            <StackPanel x:Name="Mode3Frame" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,6">
                <ToggleButton x:Name="ExaltCheck" Content="富豪后使用崇高石"
                              Style="{StaticResource ModernSwitchStyle}" Foreground="#B45F06" FontSize="13"
                              FontWeight="Bold" Checked="ExaltCheck_Changed" Unchecked="ExaltCheck_Changed"/>
            </StackPanel>

            <!-- 洗装同步/点击间隔 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="操作延迟:" Foreground="#334455" FontSize="12" VerticalAlignment="Center"/>
                <Slider x:Name="DelaySlider" Minimum="10" Maximum="200" Value="33" Width="140"
                        VerticalAlignment="Center" Margin="8,0"/>
                <TextBlock x:Name="DelayValue" Text="33 ms" Foreground="#334455" FontSize="12"
                           VerticalAlignment="Center" Margin="4,0"/>
                <TextBlock Text="通货点击后的服务器同步等待" Foreground="#8A9AAA" FontSize="10"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <!-- 通货选择 -->
            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="💰 通货选择" Foreground="{StaticResource AccentBrush}" FontSize="13"
                               FontWeight="Bold" Margin="0,0,0,6"/>
                    <ItemsControl x:Name="CurrencyGrid">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <!-- 装备坐标行 -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="📍 装备坐标" Foreground="{StaticResource AccentBrush}" FontSize="11"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button x:Name="ItemCoordButton" Content="设定坐标" Style="{StaticResource CardButton}"
                                Margin="8,0,0,0" Click="ItemCoordButton_Click"/>
                        <Button x:Name="ItemClearButton" Content="✕" Width="26" Visibility="Collapsed"
                                Margin="4,0,0,0" Click="ItemClearButton_Click"
                                Background="#14C0392B" BorderBrush="#33C0392B" BorderThickness="1"
                                Foreground="#C0392B" FontSize="10" Cursor="Hand"/>
                        <Button x:Name="ClearAllCoordsButton" Content="🗑 清空全部" Style="{StaticResource CardButton}"
                                Margin="12,0,0,0" Click="ClearAllCoordsButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 词缀规则 -->
            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="📋 词缀规则" Foreground="{StaticResource AccentBrush}" FontSize="13"
                               FontWeight="Bold" Margin="0,0,0,6"/>

                    <!-- 预设行 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="配置预设:" Foreground="#334455" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox x:Name="PresetCombo" Width="160" Margin="8,0,0,0" FontSize="11"
                                  SelectionChanged="PresetCombo_SelectionChanged"/>
                        <Button x:Name="SavePresetButton" Content="💾 保存" Style="{StaticResource CardButton}"
                                Margin="8,0,0,0" Click="SavePresetButton_Click"/>
                        <Button x:Name="DeletePresetButton" Content="删除" Style="{StaticResource CardButton}"
                                Foreground="#C0392B" IsEnabled="False" Margin="4,0,0,0"
                                Click="DeletePresetButton_Click" ToolTip="删除选中预设，当前词缀设置保留"/>
                        <Button x:Name="OpenPresetsButton" Content="📁" Width="28" Margin="4,0,0,0"
                                Click="OpenPresetsButton_Click" Style="{StaticResource CardButton}" FontSize="14"/>
                    </StackPanel>

                    <!-- 主词缀池 -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="主词缀池" Foreground="#334455" FontSize="12" VerticalAlignment="Center"/>
                        <Button x:Name="ClearPrimaryButton" Content="🗑 清空" Foreground="#C0392B" FontSize="10"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0"
                                Click="ClearPrimaryButton_Click"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,0,0">
                            <TextBlock Text="命中数:" Foreground="#334455" FontSize="12" VerticalAlignment="Center"/>
                            <RadioButton x:Name="PrimaryHit0" Content="0" Style="{StaticResource HitButton}" Tag="0" GroupName="PrimaryHit" Checked="HitCount_Checked"/>
                            <RadioButton x:Name="PrimaryHit1" Content="1" Style="{StaticResource HitButton}" Tag="1" GroupName="PrimaryHit" Checked="HitCount_Checked"/>
                            <RadioButton x:Name="PrimaryHit2" Content="2" Style="{StaticResource HitButton}" Tag="2" GroupName="PrimaryHit" Checked="HitCount_Checked"/>
                            <RadioButton x:Name="PrimaryHit3" Content="3" Style="{StaticResource HitButton}" Tag="3" GroupName="PrimaryHit" Checked="HitCount_Checked"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBox x:Name="PrimaryInput" Width="220" FontSize="11" Padding="4,3"
                                 Background="#B3FFFFFF" BorderBrush="#260050A0" BorderThickness="1"
                                 KeyDown="AffixInput_KeyDown" Tag="primary"
                                 ToolTip="输入主词缀，如：最大生命"/>
                        <Button Content="+ 添加" Background="#2D6A4F" Foreground="White" BorderThickness="0"
                                Padding="10,3" FontSize="11" Cursor="Hand" Margin="6,0,0,0"
                                Click="AddAffixButton_Click" Tag="primary"/>
                    </StackPanel>
                    <WrapPanel x:Name="PrimaryTags" Margin="0,4,0,2"/>

                    <!-- 次级词缀池 -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="次级词缀池" Foreground="#334455" FontSize="12" VerticalAlignment="Center"/>
                        <Button x:Name="ClearSecondaryButton" Content="🗑 清空" Foreground="#C0392B" FontSize="10"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0"
                                Click="ClearSecondaryButton_Click"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,0,0">
                            <TextBlock Text="命中数:" Foreground="#334455" FontSize="12" VerticalAlignment="Center"/>
                            <RadioButton x:Name="SecondaryHit0" Content="0" Style="{StaticResource HitButton}" Tag="0" GroupName="SecondaryHit" Checked="HitCount_Checked"/>
                            <RadioButton x:Name="SecondaryHit1" Content="1" Style="{StaticResource HitButton}" Tag="1" GroupName="SecondaryHit" Checked="HitCount_Checked"/>
                            <RadioButton x:Name="SecondaryHit2" Content="2" Style="{StaticResource HitButton}" Tag="2" GroupName="SecondaryHit" Checked="HitCount_Checked"/>
                            <RadioButton x:Name="SecondaryHit3" Content="3" Style="{StaticResource HitButton}" Tag="3" GroupName="SecondaryHit" Checked="HitCount_Checked"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBox x:Name="SecondaryInput" Width="220" FontSize="11" Padding="4,3"
                                 Background="#B3FFFFFF" BorderBrush="#260050A0" BorderThickness="1"
                                 KeyDown="AffixInput_KeyDown" Tag="secondary"
                                 ToolTip="输入次级词缀，如：火焰抗性"/>
                        <Button Content="+ 添加" Background="#2A6496" Foreground="White" BorderThickness="0"
                                Padding="10,3" FontSize="11" Cursor="Hand" Margin="6,0,0,0"
                                Click="AddAffixButton_Click" Tag="secondary"/>
                    </StackPanel>
                    <WrapPanel x:Name="SecondaryTags" Margin="0,4,0,2"/>

                    <!-- 排除词缀 -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="排除词缀" Foreground="#334455" FontSize="12" VerticalAlignment="Center"/>
                        <Button x:Name="ClearExcludeButton" Content="🗑 清空" Foreground="#C0392B" FontSize="10"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0"
                                Click="ClearExcludeButton_Click"/>
                        <TextBlock Text="出现任一即判定失败" Foreground="#C0392B" FontSize="11"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBox x:Name="ExcludeInput" Width="220" FontSize="11" Padding="4,3"
                                 Background="#B3FFFFFF" BorderBrush="#260050A0" BorderThickness="1"
                                 KeyDown="AffixInput_KeyDown" Tag="exclude"
                                 ToolTip="输入排除词缀"/>
                        <Button Content="+ 添加" Background="#962A2A" Foreground="White" BorderThickness="0"
                                Padding="10,3" FontSize="11" Cursor="Hand" Margin="6,0,0,0"
                                Click="AddAffixButton_Click" Tag="exclude"/>
                    </StackPanel>
                    <WrapPanel x:Name="ExcludeTags" Margin="0,4,0,2"/>
                </StackPanel>
            </Border>

            <!-- 状态（启停快捷键来自 host 设置，游戏内直接触发，无需切回窗口） -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock x:Name="CraftHotkeyHint" Text="⚡ 游戏内热键启动 / 停止" Foreground="{StaticResource AccentBrush}"
                           FontSize="12" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock x:Name="CraftStatusText" Text="就绪" Foreground="#445566" FontSize="12"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
