<UserControl x:Class="ShiKe.Tools.Settings.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             PreviewKeyDown="Page_PreviewKeyDown"
             PreviewKeyUp="Page_PreviewKeyUp">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#334455"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="HotkeyButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="118"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#F8FBFE"/>
            <Setter Property="BorderBrush" Value="#B9D0E2"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="ClearHotkeyButton" TargetType="Button" BasedOn="{StaticResource HotkeyButton}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="ToolTip" Value="清空此项热键，功能启用状态不变"/>
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#445566"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,8" MaxWidth="520">
            <TextBlock Text="设置" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="统一管理热键、目标进程、声音和通知。所有修改完成后立即生效并保存。"
                       FontSize="12" Foreground="#778899" Margin="0,4,0,12" TextWrapping="Wrap"/>

            <Border x:Name="ResultPanel" Background="#EAF3FA" BorderBrush="#D4E4F0" BorderThickness="1"
                    CornerRadius="6" Padding="9,6" Margin="0,0,0,10" Visibility="Collapsed">
                <TextBlock x:Name="ResultText" Foreground="#667788" TextWrapping="Wrap"/>
            </Border>

            <Border Background="#F0F6FB" BorderBrush="#D4E4F0" BorderThickness="1"
                    CornerRadius="8" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="热键" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/>
                            <RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="启动洗装" Style="{StaticResource SettingLabel}"/>
                        <Button x:Name="CraftStartButton" Grid.Row="0" Grid.Column="1" Tag="craft_start"
                                Style="{StaticResource HotkeyButton}" Click="BeginHotkeyCapture_Click"/>
                        <Button Grid.Row="0" Grid.Column="2" Tag="craft_start" Content="清空"
                                Style="{StaticResource ClearHotkeyButton}" Click="ClearHotkey_Click"/>
                        <TextBlock Grid.Row="1" Text="停止洗装" Style="{StaticResource SettingLabel}"/>
                        <Button x:Name="CraftStopButton" Grid.Row="1" Grid.Column="1" Tag="craft_stop"
                                Style="{StaticResource HotkeyButton}" Click="BeginHotkeyCapture_Click"/>
                        <Button Grid.Row="1" Grid.Column="2" Tag="craft_stop" Content="清空"
                                Style="{StaticResource ClearHotkeyButton}" Click="ClearHotkey_Click"/>
                        <TextBlock Grid.Row="2" Text="坐标录制" Style="{StaticResource SettingLabel}"/>
                        <Button x:Name="CoordinateButton" Grid.Row="2" Grid.Column="1" Tag="coordinate"
                                Style="{StaticResource HotkeyButton}" Click="BeginHotkeyCapture_Click"/>
                        <Button Grid.Row="2" Grid.Column="2" Tag="coordinate" Content="清空"
                                Style="{StaticResource ClearHotkeyButton}" Click="ClearHotkey_Click"/>
                        <TextBlock Grid.Row="3" Text="连点器切换" Style="{StaticResource SettingLabel}"/>
                        <Button x:Name="ClickerToggleButton" Grid.Row="3" Grid.Column="1" Tag="clicker_toggle"
                                Style="{StaticResource HotkeyButton}" Click="BeginHotkeyCapture_Click"/>
                        <Button Grid.Row="3" Grid.Column="2" Tag="clicker_toggle" Content="清空"
                                Style="{StaticResource ClearHotkeyButton}" Click="ClearHotkey_Click"/>
                        <TextBlock Grid.Row="4" Text="连点器按住" Style="{StaticResource SettingLabel}"/>
                        <Button x:Name="ClickerHoldButton" Grid.Row="4" Grid.Column="1" Tag="clicker_hold"
                                Style="{StaticResource HotkeyButton}" Click="BeginHotkeyCapture_Click"/>
                        <Button Grid.Row="4" Grid.Column="2" Tag="clicker_hold" Content="清空"
                                Style="{StaticResource ClearHotkeyButton}" Click="ClearHotkey_Click"/>
                        <TextBlock Grid.Row="5" Text="按键循环" Style="{StaticResource SettingLabel}"/>
                        <Button x:Name="KeyLoopButton" Grid.Row="5" Grid.Column="1" Tag="keyloop"
                                Style="{StaticResource HotkeyButton}" Click="BeginHotkeyCapture_Click"/>
                        <Button Grid.Row="5" Grid.Column="2" Tag="keyloop" Content="清空"
                                Style="{StaticResource ClearHotkeyButton}" Click="ClearHotkey_Click"/>
                        <TextBlock Grid.Row="6" Text="一键回城" Style="{StaticResource SettingLabel}"/>
                        <Button x:Name="HideoutButton" Grid.Row="6" Grid.Column="1" Tag="hideout"
                                Style="{StaticResource HotkeyButton}" Click="BeginHotkeyCapture_Click"/>
                        <Button Grid.Row="6" Grid.Column="2" Tag="hideout" Content="清空"
                                Style="{StaticResource ClearHotkeyButton}" Click="ClearHotkey_Click"/>
                    </Grid>
                    <TextBlock Text="点击右侧按键后输入新热键；Esc 取消。除“连点器按住”外，不能只绑定 Ctrl/Alt/Shift。"
                               Foreground="#7B8C9D" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="新绑定优先，冲突旧项会自动清空；未绑定项不响应快捷键。洗装停止热键未绑定时无法启动洗装。"
                               Foreground="#7B8C9D" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <Button Content="恢复默认热键" Width="104" Height="29" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Background="#66FFFFFF" BorderBrush="#B9D0E2"
                            Foreground="{StaticResource AccentBrush}" Cursor="Hand"
                            Click="RestoreDefaultHotkeys_Click"/>
                </StackPanel>
            </Border>

            <Border Background="#F0F6FB" BorderBrush="#D4E4F0" BorderThickness="1"
                    CornerRadius="8" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="目标游戏进程" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ProcessCombo" Height="29" VerticalContentAlignment="Center"
                                  SelectionChanged="RealtimeSetting_Changed"/>
                        <Button Grid.Column="1" Content="刷新" Width="62" Margin="8,0,0,0" Click="RefreshProcesses_Click"/>
                    </Grid>
                    <ToggleButton x:Name="AutoDetectCheck" Content="启动时自动检测 PoE 进程" Margin="0,9,0,0"
                                  Style="{StaticResource ModernSwitchStyle}"
                                  Checked="RealtimeSetting_Changed" Unchecked="RealtimeSetting_Changed"/>
                    <TextBlock Text="未选择目标时，所有可能发送输入的启动操作都会被安全拦截。"
                               Foreground="#7B8C9D" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#F0F6FB" BorderBrush="#D4E4F0" BorderThickness="1"
                    CornerRadius="8" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="声音与通知" Style="{StaticResource SectionTitle}"/>
                    <ToggleButton x:Name="CraftSoundCheck" Content="Craft 命中时播放音效"
                                  Style="{StaticResource ModernSwitchStyle}"
                                  Checked="RealtimeSetting_Changed" Unchecked="RealtimeSetting_Changed"/>
                    <Grid Margin="20,7,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SoundCombo" Height="29" VerticalContentAlignment="Center"
                                  SelectionChanged="RealtimeSetting_Changed"/>
                        <Button Grid.Column="1" Content="试听" Width="55" Margin="7,0,0,0" Click="PreviewSound_Click"/>
                        <Button Grid.Column="2" Content="刷新" Width="55" Margin="7,0,0,0" Click="RefreshSounds_Click"/>
                        <Button Grid.Column="3" Content="目录" Width="55" Margin="7,0,0,0" Click="OpenSoundsFolder_Click"/>
                    </Grid>
                    <ToggleButton x:Name="CraftPopupCheck" Content="Craft 启动、停止和结果弹窗" Margin="0,3"
                                  Style="{StaticResource ModernSwitchStyle}"
                                  Checked="RealtimeSetting_Changed" Unchecked="RealtimeSetting_Changed"/>
                    <ToggleButton x:Name="ClickerNotificationCheck" Content="连点器启停弹窗" Margin="0,3"
                                  Style="{StaticResource ModernSwitchStyle}"
                                  Checked="RealtimeSetting_Changed" Unchecked="RealtimeSetting_Changed"/>
                    <ToggleButton x:Name="KeyLoopNotificationCheck" Content="按键循环启停弹窗" Margin="0,3"
                                  Style="{StaticResource ModernSwitchStyle}"
                                  Checked="RealtimeSetting_Changed" Unchecked="RealtimeSetting_Changed"/>
                    <TextBlock Text="WAV/MP3 通常由 Windows 直接支持；OGG/FLAC 是否可播放取决于系统已安装的解码器，可先点“试听”确认。"
                               Foreground="#7B8C9D" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="#FFF9EC" BorderBrush="#E8D7A8" BorderThickness="1"
                    CornerRadius="8" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="隐私声明" FontWeight="Bold" Foreground="#7B6334"/>
                    <TextBlock Text="本工具启动时会尝试发送一条匿名 pageview，内容为固定应用/页面标识、语言标记及兼容字段；不会读取或上传个人身份、真实设备参数、游戏数据、规则、坐标或剪贴板内容。"
                               Foreground="#665A44" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,5"/>
                    <Button Content="查看统计" Width="82" HorizontalAlignment="Left" Padding="5,2"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentBrush}"
                            Cursor="Hand" Click="OpenStatistics_Click"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
