<UserControl x:Class="ShiKe.Tools.KeyLoop.KeyLoopPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="Page_PreviewKeyDown">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,8" MaxWidth="540">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="按键循环" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                <ToggleButton x:Name="EnableToolSwitch" Grid.Column="1" Content="启用按键循环"
                              Style="{StaticResource ModernSwitchStyle}"
                              Checked="EnableToolSwitch_Changed" Unchecked="EnableToolSwitch_Changed"/>
            </Grid>
            <TextBlock Text="每个启用的按键按自己的间隔独立触发，离开游戏后自动暂停。"
                       FontSize="12" Foreground="#778899" Margin="0,4,0,12"/>

            <Border Background="#F0F6FB" BorderBrush="#D4E4F0" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="启停热键" Foreground="#334455" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HotkeyText" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"
                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="按一次启动，再按一次停止" Foreground="#7B8C9D" FontSize="11"
                               Margin="16,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="SlotPanel"/>

            <Button x:Name="MoreButton" Content="▼ 加载更多 (5/10)" Height="31" Margin="0,5,0,10"
                    Background="#66FFFFFF" BorderBrush="#260050A0" Foreground="#6A7A8A"
                    Cursor="Hand" Click="MoreButton_Click"/>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="ToggleButton" Content="启动循环" Width="110" Height="34"
                        Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                        FontWeight="Bold" Cursor="Hand" Click="ToggleButton_Click"/>
                <TextBlock x:Name="StatusDot" Text="●" Foreground="#AAAAAA" FontSize="15"
                           Margin="18,0,5,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="按键循环就绪" Foreground="#445566" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="点击某个按键框后，直接按下要循环的单个键；可设置字母、数字、功能键、方向键或单独修饰键。"
                       Foreground="#7B8C9D" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
