<UserControl x:Class="ShiKe.Tools.Hideout.HideoutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="28,20" MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="一键回城" FontSize="20" FontWeight="Bold" Foreground="#1a6fb5" Margin="0,0,0,16"/>

        <Border Background="#f0f6fb" CornerRadius="8" Padding="16,14" BorderBrush="#d4e4f0" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="EnableCheck"
                              Content="启用一键回城"
                              FontSize="15"
                              VerticalAlignment="Center"
                              Checked="OnToggleChanged"
                              Unchecked="OnToggleChanged"/>
                    <TextBlock x:Name="HotkeyLabel" Text="（热键）" Foreground="#668" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#556" FontSize="13" LineHeight="20">
                    <Run x:Name="InstructionHotkeyRun" Text="游戏内按热键：自动打开聊天框输入 "/>
                    <Run Text="/hideout" FontFamily="Consolas" Foreground="#1a6fb5"/>
                    <Run Text=" 并发送，返回藏身处（与 Python 旧版行为一致）。"/>
                </TextBlock>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#889" FontSize="12">
                    <Run Text="提示：需在游戏设置中允许聊天输入；游戏为管理员运行时拾刻请同样以管理员运行。"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
